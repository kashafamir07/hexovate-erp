[TEMPLATE]
# Server environment (copy to .env and fill in)
NODE_ENV=development
PORT=4000

# MongoDB connection string.
# Production/development: point at a real MongoDB (local or Atlas).
# When MONGODB_URI is empty, the server starts an in-process ephemeral
# MongoDB (mongodb-memory-server) — convenient for demos and tests.
MONGODB_URI=

# JWT signing secret — use a long random string in production.
JWT_SECRET=dev-only-secret-change-me
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d

# Frontend origin(s) allowed by CORS (comma-separated).
# In production ONLY these origins are accepted — no localhost wildcard.
CLIENT_URL=http://localhost:5173

# Rate limiting (requests per IP per window).
# RATE_LIMIT_ENABLED=false disables limiting — dev/demo only, never production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_API_MAX=600
RATE_LIMIT_API_WINDOW_MIN=15